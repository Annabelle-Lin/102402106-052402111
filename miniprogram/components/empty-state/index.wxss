/* ============ 空状态 ============ */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 60rpx 80rpx;
  gap: 18rpx;
}
.empty-img {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 10rpx;
  opacity: .96;
}
.empty-txt {
  font-size: 30rpx;
  font-weight: 600;
  color: #6E6B85;
  text-align: center;
}
.empty-sub {
  font-size: 25rpx;
  color: #A6A3B8;
  text-align: center;
  line-height: 1.6;
}
.empty-btn {
  margin-top: 20rpx;
  height: 84rpx;
  padding: 0 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #9B7DEE 0%, #8B6FE8 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 84rpx;
  box-shadow: 0 12rpx 28rpx rgba(139,111,232,.32);
}
.empty-btn:active { transform: scale(.97); opacity: .92; }
