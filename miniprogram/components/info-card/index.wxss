/* ============ 信息卡片 · 两列网格 ============ */
.icard {
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 26rpx rgba(139, 111, 232, 0.08);
  transition: transform .2s;
}
.icard:active { transform: scale(.975); }

/* ---------- 缩略图区 ---------- */
.icard-thumb {
  position: relative;
  width: 100%;
  height: 260rpx;
  background: linear-gradient(160deg, #FAF8FF 0%, #F5F2FC 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.thumb-img {
  width: 78%;
  height: 78%;
}

/* 右上角类型胶囊 */
.badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}
.badge-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
/* 寻物 = 薄荷绿 */
.badge-mint   { background: #E3F9F0; color: #2FA97E; }
.badge-mint .badge-dot   { background: #3ECFA0; }
/* 招领 = 淡紫 */
.badge-purple { background: #EFE9FD; color: #6E4FC8; }
.badge-purple .badge-dot { background: #8B6FE8; }

/* ---------- 编辑 / 删除（仅“我的发布”）---------- */
.icard-acts {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  display: flex;
  gap: 12rpx;
  z-index: 3;
}
.icard-act {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .18s;
}
.icard-act:active { transform: scale(.9); }
.icard-act-edit {
  background: linear-gradient(135deg, #9B7DEE 0%, #8B6FE8 100%);
  box-shadow: 0 6rpx 16rpx rgba(139,111,232,.34);
}
.icard-act-del {
  background: linear-gradient(135deg, #FF9E9E 0%, #F08A8A 100%);
  box-shadow: 0 6rpx 16rpx rgba(240,138,138,.34);
}
.icard-act-ico { width: 26rpx; height: 26rpx; }
/* 有操作按钮时，类型胶囊左移避让 */
.icard-editable .badge { right: 18rpx; top: 18rpx; }

/* ---------- 文字区 ---------- */
.icard-body { padding: 22rpx 24rpx 20rpx; }

.icard-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #26243C;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.icard-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}
.meta-place {
  font-size: 25rpx;
  color: #4A4763;
  max-width: 130rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meta-sep { color: #D6D3E2; font-size: 22rpx; }
.meta-time { font-size: 25rpx; color: #8E8BA3; }

/* ---------- 底部 pin 行 ---------- */
.icard-foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F4F3FA;
}
.foot-pin   { width: 22rpx; height: 22rpx; flex-shrink: 0; }
.foot-place {
  flex: 1;
  font-size: 22rpx;
  color: #B7B4C7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.foot-arrow { width: 22rpx; height: 22rpx; flex-shrink: 0; }
