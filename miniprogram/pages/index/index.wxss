/* 首页 · 早期朴素版样式 */
.home {
  min-height: 100vh;
  background: #F5F5F5;
}

.header {
  padding: 30rpx 30rpx 20rpx;
  background: #FFFFFF;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.list {
  padding: 20rpx;
}
.item {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.item-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.item-type {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.type-lost { background: #E6F7EE; color: #2FA97E; }
.type-found { background: #F0EAFE; color: #6E4FC8; }

.item-place {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
}
.item-time {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.empty, .loading {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
